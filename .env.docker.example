# Variáveis do CONTÊINER da API. Copie este arquivo para .env.docker e preencha:
#   cp .env.docker.example .env.docker
# O .env.docker NÃO é versionado (.gitignore) e NÃO entra na imagem (.dockerignore);
# ele é entregue ao contêiner em tempo de execução: docker run --env-file .env.docker ...
# O .env de desenvolvimento (host "localhost", FLASK_DEBUG=1) não serve dentro do contêiner.

# PostgreSQL alcançado pela rede Docker: o host é o NOME DO CONTÊINER do banco
# (rota-financeira-db) e a senha é a do banco. Defina a senha SOMENTE neste arquivo local.
DATABASE_URL=postgresql+psycopg://emerson:troque-esta-senha@rota-financeira-db:5432/emerson

# Chave que assina os tokens JWT. TROQUE por um valor aleatório e secreto.
# Sugestão para gerar: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-esta-chave

# Origens autorizadas no CORS (separadas por vírgula): endereços do frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Nunca use o modo de depuração dentro do contêiner.
FLASK_DEBUG=0

# Opcionais (valores padrão entre parênteses):
# Validade do token de login, em minutos (60).
# JWT_ACCESS_TOKEN_EXPIRES_MINUTOS=60
# Número de processos do gunicorn (2).
# WEB_CONCURRENCY=2
# API do Banco Central (índices CDI e IPCA):
# BACEN_URL_BASE=https://api.bcb.gov.br/dados/serie/bcdata.sgs
# BACEN_TIMEOUT_SEGUNDOS=8
# INDICES_TTL_HORAS=12
