# Copie este arquivo para .env e ajuste os valores. O .env NÃO é versionado.

# Banco de dados (PostgreSQL). O prefixo "+psycopg" indica o driver usado pelo SQLAlchemy.
# Defina a senha SOMENTE no seu .env local (nunca neste arquivo) e use a mesma
# senha em POSTGRES_PASSWORD e em DATABASE_URL.
DATABASE_URL=postgresql+psycopg://emerson:troque-esta-senha@localhost:5432/emerson

# Banco dos testes de integração (opcional). Sem esta variável, os testes usam o banco
# "bd_test" na mesma instância do DATABASE_URL (mesmo usuário e senha), criado por eles.
# O nome do banco DEVE terminar em "_test": os testes apagam todos os dados dele.
# TEST_DATABASE_URL=postgresql+psycopg://emerson:troque-esta-senha@localhost:5432/bd_test

# Usadas apenas ao criar o container do PostgreSQL (docker run, ver plano.md).
POSTGRES_USER=emerson
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=emerson

# Chave usada para assinar os tokens JWT. TROQUE por um valor aleatório e secreto.
# Sugestão para gerar: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-esta-chave

# Validade do token de login, em minutos (opcional; padrão 60).
# JWT_ACCESS_TOKEN_EXPIRES_MINUTOS=60

# API do Banco Central (índices CDI e IPCA) — todas opcionais.
# BACEN_URL_BASE=https://api.bcb.gov.br/dados/serie/bcdata.sgs
# Tempo máximo de espera pela resposta do BACEN, em segundos (padrão 8).
# BACEN_TIMEOUT_SEGUNDOS=8
# Validade do cache dos índices, em horas (padrão 12; aceita fração, ex.: 0.5).
# INDICES_TTL_HORAS=12

# Origens autorizadas no CORS (separadas por vírgula): endereços do frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Modo de depuração do Flask (use 0 fora do desenvolvimento).
FLASK_APP=run.py
FLASK_DEBUG=1
