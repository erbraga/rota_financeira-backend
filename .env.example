# Copie este arquivo para .env e ajuste os valores. O .env NÃO é versionado.

# Banco de dados (PostgreSQL). O prefixo "+psycopg" indica o driver usado pelo SQLAlchemy.
# Defina a senha SOMENTE no seu .env local (nunca neste arquivo) e use a mesma
# senha em POSTGRES_PASSWORD e em DATABASE_URL.
DATABASE_URL=postgresql+psycopg://emerson:troque-esta-senha@localhost:5432/emerson

# Usadas apenas ao criar o container do PostgreSQL (docker run, ver plano.md).
POSTGRES_USER=emerson
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=emerson

# Chave usada para assinar os tokens JWT. TROQUE por um valor aleatório e secreto.
# Sugestão para gerar: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=troque-esta-chave

# Origens autorizadas no CORS (separadas por vírgula): endereços do frontend.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Modo de depuração do Flask (use 0 fora do desenvolvimento).
FLASK_DEBUG=1
